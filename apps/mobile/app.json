{
  "expo": {
    "name": "Ministre",
    "slug": "ministre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ministre",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "br.com.ministre.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.ministre.app"
    },
    "web": {
      "output": "static",
      "favicon": "./public/app-icons/icon-192.png",
      "name": "Ministre",
      "shortName": "Ministre",
      "backgroundColor": "#FAFAF9",
      "themeColor": "#FAFAF9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Ministre usa suas fotos para a foto de perfil e o logo do ministério.",
          "cameraPermission": "O Ministre usa a câmera para tirar a sua foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#FAFAF9"
  }
}
